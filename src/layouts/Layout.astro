---
import '../styles/global.css';

const { title = 'Rirē — Le lien avant tout' } = Astro.props;
---
<!DOCTYPE html>
<html lang="fr">
<head>
	<meta charset="UTF-8" />
	<meta name="viewport" content="width=device-width, initial-scale=1.0" />
	<meta name="description" content="Rirē — Plateforme d'entraide intergénérationnelle entre familles aidantes et étudiants pour des missions auprès d'aînés isolés." />
	<link rel="icon" type="image/svg+xml" href="/favicon.svg" />

	<!-- Google Fonts -->
	<link rel="preconnect" href="https://fonts.googleapis.com" />
	<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
	<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Plus+Jakarta+Sans:wght@500;600;700;800&display=swap" rel="stylesheet" />

	<title>{title}</title>
</head>
<body class="bg-white text-rire-ink font-sans">
	<slot />
</body>
</html>
