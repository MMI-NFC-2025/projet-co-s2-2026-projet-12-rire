---
const {
	logoSrc = '/Logo%20RBLeu.svg',
	titleSrc = '/TitreHeader.svg',
} = Astro.props;
---

<header class="bg-rire-bg border-b border-gray-100">
	<nav class="max-w-7xl mx-auto px-6 py-5 flex items-center justify-between gap-6">
		<a href="/" class="flex items-center gap-3 shrink-0" aria-label="Rirē, accueil">
			<img src={logoSrc} alt="" aria-hidden="true" class="h-10 w-10" />
			<img src={titleSrc} alt="Rirē" class="h-8 w-auto" />
		</a>
		<div class="hidden md:flex items-center gap-8">
			<a href="/familles" class="text-sm font-medium text-rire-ink hover:text-rire-rose transition-colors">Pour les familles</a>
			<a href="/etudiants" class="text-sm font-medium text-rire-ink hover:text-rire-orange transition-colors">Pour les étudiants</a>
<a id="nav-connexion" href="/app/connexion" class="text-sm font-semibold bg-rire-ink text-white px-5 py-2.5 rounded-full hover:bg-rire-blue transition-colors">Connexion</a>

			<a id="nav-compte" href="/app/compte" class="hidden text-sm font-semibold bg-rire-blue text-white px-5 py-2.5 rounded-full hover:opacity-90 transition-colors">Mon compte</a>

			<button id="nav-logout" class="hidden text-sm font-medium text-rire-muted hover:text-rire-ink transition-colors">Déconnexion</button>
		</div>
	</nav>
</header>

<script>
	import { isAuthValid, logout } from '../lib/backend.mjs';

	if (isAuthValid()) {
		document.getElementById('nav-connexion')?.classList.add('hidden');
		document.getElementById('nav-compte')?.classList.remove('hidden');
		document.getElementById('nav-logout')?.classList.remove('hidden');
	}

	document.getElementById('nav-logout')?.addEventListener('click', () => {
		logout();
		window.location.href = '/';
	});
</script>