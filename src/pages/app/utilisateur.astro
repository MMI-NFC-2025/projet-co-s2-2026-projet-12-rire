---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/Nav.astro';
import Footer from '../../components/Footer.astro';
---
<Layout title="Profil — Rirē">
	<Nav />
	<main class="max-w-3xl mx-auto px-6 py-12">
		<div id="loading" class="text-center py-12 text-rire-muted">Chargement...</div>
		<div id="not-found" class="hidden text-center py-12"><p class="text-rire-muted">Utilisateur introuvable.</p></div>
		<div id="content" class="hidden">
			<a href="javascript:history.back()" class="text-sm text-rire-muted hover:text-rire-ink mb-6 inline-block">← Retour</a>
			<div class="bg-white border border-gray-200 rounded-2xl p-8 mb-6">
				<div id="header" class="flex items-start gap-4 mb-6"></div>
				<div id="bio" class="text-rire-ink"></div>
			</div>
			<div id="stats" class="grid grid-cols-3 gap-4 mb-6"></div>
			<div class="bg-white border border-gray-200 rounded-2xl p-8">
				<h2 class="font-display font-semibold text-rire-ink mb-4">Avis reçus</h2>
				<div id="avis-list" class="space-y-3"></div>
			</div>
			<button id="btn-signaler" class="mt-6 text-sm text-rire-muted underline hover:text-red-600">Signaler ce profil</button>
		</div>
	</main>
	<Footer />
</Layout>
<script>
	import { oneUser, userStats, newSignalement, isAuthValid, currentUser } from '../../lib/backend.mjs';
	const userId = new URLSearchParams(window.location.search).get('id');
	if (!userId) { document.getElementById('loading').classList.add('hidden'); document.getElementById('not-found').classList.remove('hidden'); }
	else { load(); }
	async function load() {
		try {
			const user = await oneUser(userId);
			const stats = await userStats(userId);
			const isF = user.type === 'famille';
			const couleur = isF ? 'rose' : 'orange';
			const avatarUrl = user.avatar ? `https://rire.maheyralambo.fun/api/files/users/${user.id}/${user.avatar}` : null;
			const avatarHtml = avatarUrl 
				? `<img src="${avatarUrl}" alt="Avatar de ${user.prenom} ${user.nom}" class="w-20 h-20 rounded-xl object-cover" />`
				: `<div class="w-20 h-20 rounded-xl bg-rire-${couleur} flex items-center justify-center text-2xl font-bold text-rire-ink">${(user.prenom?.[0] || '') + (user.nom?.[0] || '')}</div>`;
			document.getElementById('header').innerHTML = `
				${avatarHtml}
				<div class="flex-1">
					<div class="text-xs font-semibold tracking-widest text-rire-${couleur} uppercase mb-1">${isF ? 'Famille' : 'Étudiant'}</div>
					<h1 class="font-display text-3xl font-bold text-rire-ink">${user.prenom} ${user.nom}</h1>
					<p class="text-sm text-rire-muted">${user.ville}${user.ecole ? ` · ${user.ecole}` : ''}${user.niveauEtudes ? ` · ${user.niveauEtudes}` : ''}</p>
				</div>`;
			document.getElementById('bio').textContent = (user.bio || '').replace(/<[^>]*>/g, '') || 'Pas de bio renseignée.';
			document.getElementById('stats').innerHTML = `
				<div class="bg-white border border-gray-200 rounded-lg p-4 text-center"><div class="text-2xl font-bold text-rire-blue">${stats.missionsTerminees}</div><div class="text-xs text-rire-muted">missions terminées</div></div>
				<div class="bg-white border border-gray-200 rounded-lg p-4 text-center"><div class="text-2xl font-bold text-rire-blue">${stats.noteMoyenne ? stats.noteMoyenne.toFixed(1) + '★' : '—'}</div><div class="text-xs text-rire-muted">note moyenne</div></div>
				<div class="bg-white border border-gray-200 rounded-lg p-4 text-center"><div class="text-2xl font-bold text-rire-blue">${stats.nbAvis}</div><div class="text-xs text-rire-muted">avis reçus</div></div>`;
			document.getElementById('avis-list').innerHTML = stats.avisRecus.length === 0
				? '<p class="text-rire-muted text-sm">Pas encore d\'avis.</p>'
				: stats.avisRecus.map(a => {
					const auteur = a.expand?.auteur;
					return `<div class="border-b border-gray-100 pb-3 last:border-0">
						<div class="flex items-center gap-2 mb-1"><span class="text-rire-orange">${'★'.repeat(a.note)}${'☆'.repeat(5 - a.note)}</span>${auteur ? `<span class="text-xs text-rire-muted">par ${auteur.prenom}</span>` : ''}</div>
						<p class="text-sm text-rire-ink">${(a.commentaire || '').replace(/<[^>]*>/g, '')}</p>
					</div>`;
				}).join('');
			document.getElementById('loading').classList.add('hidden');
			document.getElementById('content').classList.remove('hidden');
		} catch (err) { console.error(err); document.getElementById('loading').classList.add('hidden'); document.getElementById('not-found').classList.remove('hidden'); }
	}
	document.getElementById('btn-signaler').addEventListener('click', async () => {
		if (!isAuthValid()) { window.location.href = '/app/connexion'; return; }
		const desc = prompt('Décris le motif du signalement :');
		if (!desc) return;
		try {
			await newSignalement({ auteur: currentUser().id, concerne: userId, motif: 'comportement', description: desc, statut: 'nouveau' });
			alert('Signalement envoyé. Merci.');
		} catch (err) { alert('Erreur : ' + (err?.message || '')); }
	});
</script>