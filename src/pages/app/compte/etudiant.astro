---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/NavApp.astro';
import Footer from '../../../components/Footer.astro';
---

<Layout title="Mon compte — Rirē">
  <Nav />
  <main class="bg-rire-ink text-rire-orange">
    <div class="max-w-5xl mx-auto px-6 py-12">
      <div id="loading" class="text-center py-12 text-rire-orange/70">Chargement...</div>

      <div id="content" class="hidden">
        <div class="flex items-center justify-between mb-2">
          <div class="text-xs font-semibold tracking-widest text-rire-orange uppercase drop-shadow-[0_0_12px_rgba(255,179,0,0.35)]">Espace étudiant</div>
          <a href="/app/compte/profil" class="text-sm text-rire-muted hover:text-rire-ink mr-4">Mon profil</a>
          <button id="btn-logout" class="text-sm text-rire-orange/80 hover:text-rire-orange">Se déconnecter</button>
        </div>
        <h1 class="font-display text-4xl font-bold text-rire-orange mb-2 drop-shadow-[0_0_14px_rgba(255,179,0,0.28)]">
          Salut <span id="user-prenom"></span>
        </h1>
        <p class="text-rire-orange/70 mb-10">Les missions disponibles près de chez toi.</p>

        <h2 class="font-display text-2xl font-semibold text-rire-orange mb-4">Missions disponibles</h2>
        <div id="missions-list" class="space-y-4 mb-12"></div>

        <h2 class="font-display text-2xl font-semibold text-rire-orange mb-4">Mes candidatures</h2>
        <div id="candidatures-list" class="space-y-3"></div>
      </div>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { isAuthValid, currentUser, logout, allMissionsOuvertes, candidaturesByEtudiant } from '../../../lib/backend.mjs';

  if (!isAuthValid()) {
    window.location.href = '/app/connexion';
  } else {
    const user = currentUser();
    if (!user || user.type !== 'etudiant') {
      window.location.href = '/app/compte/famille';
    } else {
      const userPrenomEl = document.getElementById('user-prenom');
      if (userPrenomEl) userPrenomEl.textContent = user.prenom;

      try {
        const missions = await allMissionsOuvertes();
        const listEl = document.getElementById('missions-list');

        if (listEl) {
          if (missions.length === 0) {
            listEl.innerHTML = '<p class="text-rire-orange/70">Aucune mission ouverte pour le moment.</p>';
          } else {
            listEl.innerHTML = missions.map(m => {
              const famille = m.expand?.famille;
              return `
              <a href="/app/mission?id=${m.id}" class="block bg-[#121A3A] border border-white/10 rounded-lg p-6 hover:border-rire-orange transition shadow-[0_0_0_1px_rgba(255,179,0,0.04)]">
                <div class="flex items-start justify-between mb-2">
                  <h3 class="font-display font-semibold text-rire-orange text-lg">${m.titre}</h3>
                  <span class="text-sm font-semibold text-rire-orange ml-4 whitespace-nowrap">${m.tarifHoraire}€/h</span>
                </div>
                <p class="text-sm text-rire-orange/70 mb-1">
                  📍 ${m.lieuVille} · ⏱️ ${m.dureeEstimee}h
                </p>
                ${famille ? `<p class="text-xs text-rire-orange/60">Publié par ${famille.prenom}</p>` : ''}
              </a>
            `;
            }).join('');
          }
        }

        const candidatures = await candidaturesByEtudiant(user.id);
        const candEl = document.getElementById('candidatures-list');

        if (candEl) {
          if (candidatures.length === 0) {
            candEl.innerHTML = '<p class="text-rire-orange/70 text-sm">Tu n\'as pas encore postulé à une mission.</p>';
          } else {
            const labels: Record<string, { label: string; color: string }> = {
              en_attente: { label: 'En attente', color: 'bg-white/10 text-rire-orange border border-white/10' },
              acceptee: { label: 'Acceptée 🎉', color: 'bg-rire-orange/15 text-rire-orange border border-rire-orange/30' },
              refusee: { label: 'Refusée', color: 'bg-white/10 text-rire-orange/70 border border-white/10' },
              annulee: { label: 'Annulée', color: 'bg-white/10 text-rire-orange/70 border border-white/10' }
            };
            candEl.innerHTML = candidatures.map(c => {
              const mission = c.expand?.mission;
              const st = labels[(c.statut as string)] || { label: String(c.statut), color: 'bg-gray-100' };
              return `
              <div class="bg-[#121A3A] border border-white/10 rounded-lg p-4 flex items-center justify-between">
                <div>
                  <h4 class="font-medium text-rire-orange">${mission?.titre || 'Mission'}</h4>
                  <p class="text-xs text-rire-orange/60">${mission?.lieuVille || ''}</p>
                </div>
                <span class="text-xs px-3 py-1 rounded-full ${st.color}">${st.label}</span>
              </div>
            `;
            }).join('');
          }
        }
      } catch (err) { console.error(err); }

      document.getElementById('loading')?.classList.add('hidden');
      document.getElementById('content')?.classList.remove('hidden');
    }
  }

  document.getElementById('btn-logout')?.addEventListener('click', () => {
    logout();
    window.location.href = '/';
  });
</script>
