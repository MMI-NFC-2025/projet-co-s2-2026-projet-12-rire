---
import Layout from '../../../layouts/Layout.astro';
import Nav from '../../../components/Nav.astro';
import Footer from '../../../components/Footer.astro';
---
<Layout title="Mon profil — Rirē">
	<Nav />
	<main class="max-w-2xl mx-auto px-6 py-12">
		<div id="loading" class="text-center py-12 text-rire-muted">Chargement...</div>
		<div id="content" class="hidden">
			<a href="/app/compte" class="text-sm text-rire-muted hover:text-rire-ink mb-4 inline-block">← Retour</a>
			<h1 class="font-display text-4xl font-bold text-rire-ink mb-8">Mon profil</h1>

			<form id="form-profil" class="space-y-4 bg-white border border-gray-200 rounded-2xl p-8">
				<div id="champs" class="space-y-4"></div>
				<div id="erreur" class="hidden text-red-600 text-sm p-3 bg-red-50 rounded-lg"></div>
				<div id="succes" class="hidden text-green-700 text-sm p-3 bg-green-50 rounded-lg">Profil mis à jour ✓</div>
				<button type="submit" class="w-full bg-rire-blue text-white py-3 rounded-lg font-semibold hover:opacity-90 transition">Enregistrer</button>
			</form>

			<div class="mt-8 p-6 bg-red-50 border border-red-200 rounded-2xl">
				<h3 class="font-semibold text-red-800 mb-2">Zone dangereuse</h3>
				<p class="text-sm text-red-700 mb-3">Supprimer ton compte est irréversible.</p>
				<button id="btn-delete" class="text-sm text-red-700 underline">Supprimer mon compte</button>
			</div>
		</div>
	</main>
	<Footer />
</Layout>
<script>
	import { isAuthValid, currentUser, updateUser, deleteUser, logout } from '../../../lib/backend.mjs';
	if (!isAuthValid()) { window.location.href = '/app/connexion'; }
	else {
		const user = currentUser();
		const fields = [
			{ id: 'prenom', label: 'Prénom', type: 'text', value: user.prenom, required: true },
			{ id: 'nom', label: 'Nom', type: 'text', value: user.nom, required: true },
			{ id: 'telephone', label: 'Téléphone', type: 'tel', value: user.telephone || '' },
			{ id: 'ville', label: 'Ville', type: 'text', value: user.ville, required: true },
			{ id: 'bio', label: 'Bio (optionnel)', type: 'textarea', value: user.bio || '' },
		];
		if (user.type === 'etudiant') {
			fields.push({ id: 'ecole', label: 'École / Université', type: 'text', value: user.ecole || '' });
			fields.push({ id: 'niveauEtudes', label: 'Niveau', type: 'text', value: user.niveauEtudes || '' });
		}
		document.getElementById('champs').innerHTML = fields.map(f => `
			<div>
				<label class="block text-sm font-medium text-rire-ink mb-1">${f.label}</label>
				${f.type === 'textarea'
					? `<textarea id="${f.id}" rows="3" class="w-full px-4 py-3 border border-gray-200 rounded-lg">${f.value}</textarea>`
					: `<input type="${f.type}" id="${f.id}" value="${f.value}" ${f.required ? 'required' : ''} class="w-full px-4 py-3 border border-gray-200 rounded-lg" />`}
			</div>`).join('');
		document.getElementById('loading').classList.add('hidden');
		document.getElementById('content').classList.remove('hidden');

		document.getElementById('form-profil').addEventListener('submit', async (e) => {
			e.preventDefault();
			const data = {};
			fields.forEach(f => { data[f.id] = document.getElementById(f.id).value; });
			try {
				await updateUser(user.id, data);
				document.getElementById('succes').classList.remove('hidden');
				document.getElementById('erreur').classList.add('hidden');
			} catch (err) {
				document.getElementById('erreur').textContent = 'Erreur : ' + (err?.message || '');
				document.getElementById('erreur').classList.remove('hidden');
			}
		});
		document.getElementById('btn-delete').addEventListener('click', async () => {
			if (!confirm('Supprimer ton compte définitivement ?')) return;
			try { await deleteUser(user.id); logout(); window.location.href = '/'; }
			catch (err) { alert('Erreur : ' + (err?.message || '')); }
		});
	}
</script>