---
import Layout from '../../../../layouts/Layout.astro';
import Nav from '../../../../components/NavApp.astro';
import Footer from '../../../../components/Footer.astro';
---

<Layout title="Publier une mission — Rirē">
  <Nav />
  <main class="max-w-2xl mx-auto px-6 py-12">
    <div id="loading" class="text-center py-12 text-rire-muted">Chargement...</div>

    <div id="content" class="hidden">
      <a href="/app/compte/famille" class="text-sm text-rire-muted hover:text-rire-ink mb-4 inline-block">← Retour au tableau de bord</a>
      <div class="text-xs font-semibold tracking-widest text-rire-rose uppercase mb-2 mt-4">Espace famille</div>
      <h1 class="font-display text-4xl font-bold text-rire-ink mb-2">Publier une nouvelle mission</h1>
      <p class="text-rire-muted mb-10">Décris ce dont ton proche a besoin. Plus tu es précis, mieux les étudiants pourront répondre.</p>

      <form id="form-mission" class="space-y-5">
        <div>
          <label class="block text-sm font-medium text-rire-ink mb-1">Titre de la mission</label>
          <input type="text" id="titre" placeholder="Ex : Aide aux courses du samedi" required minlength="5"
            class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-rire-blue" />
        </div>

        <div>
          <label class="block text-sm font-medium text-rire-ink mb-1">Description</label>
          <textarea id="description" rows="5" required placeholder="Précise les détails, les attentes, le profil recherché..."
            class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-rire-blue"></textarea>
        </div>

        <div>
          <label class="block text-sm font-medium text-rire-ink mb-1">Type de mission</label>
          <select id="type" required class="w-full px-4 py-3 border border-gray-200 rounded-lg bg-white">
            <option value="">Choisir...</option>
            <option value="courses">Courses</option>
            <option value="presence">Présence / compagnie</option>
            <option value="sortie">Sortie</option>
            <option value="numerique">Aide numérique</option>
            <option value="autre">Autre</option>
          </select>
        </div>

        <div class="grid grid-cols-2 gap-4">
          <div>
            <label class="block text-sm font-medium text-rire-ink mb-1">Date souhaitée</label>
            <input type="date" id="dateSouhaitee" required
              class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
          </div>
          <div>
            <label class="block text-sm font-medium text-rire-ink mb-1">Durée (heures)</label>
            <input type="number" id="dureeEstimee" min="1" value="2" required
              class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
          </div>
        </div>

        <div>
          <label class="block text-sm font-medium text-rire-ink mb-1">Tarif horaire (€)</label>
          <input type="number" id="tarifHoraire" min="10" value="15" required
            class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
          <p class="text-xs text-rire-muted mt-1">Recommandé : 12 à 18 €/h selon la complexité</p>
        </div>

        <div>
          <label class="block text-sm font-medium text-rire-ink mb-1">Adresse</label>
          <input type="text" id="lieuAdresse" required
            class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
        </div>

        <div>
          <label class="block text-sm font-medium text-rire-ink mb-1">Ville</label>
          <input type="text" id="lieuVille" required
            class="w-full px-4 py-3 border border-gray-200 rounded-lg" />
        </div>

        <div>
          <label class="block text-sm font-medium text-rire-ink mb-1">Notes pour l'étudiant (optionnel)</label>
          <textarea id="notesFamille" rows="2"
            class="w-full px-4 py-3 border border-gray-200 rounded-lg"></textarea>
        </div>

        <div id="erreur" class="hidden text-red-600 text-sm p-3 bg-red-50 rounded-lg"></div>

        <div class="flex gap-3 pt-4">
          <a href="/app/compte/famille" class="px-6 py-3 rounded-lg border border-gray-200 text-rire-ink hover:bg-gray-50 font-semibold">Annuler</a>
          <button type="submit" class="flex-1 bg-rire-blue text-white py-3 rounded-lg font-semibold hover:opacity-90 transition">
            Publier la mission
          </button>
        </div>
      </form>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { isAuthValid, currentUser, newMission } from '../../../../lib/backend.mjs';

  if (!isAuthValid()) {
    window.location.href = '/app/connexion';
  } else {
    const user = currentUser();
    if (user.type !== 'famille') {
      window.location.href = '/app/compte/etudiant';
    } else {
      document.getElementById('loading').classList.add('hidden');
      document.getElementById('content').classList.remove('hidden');
    }
  }

  document.getElementById('form-mission')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const erreur = document.getElementById('erreur');
    erreur.classList.add('hidden');

    const user = currentUser();
    const get = (id) => document.getElementById(id).value;

    const data = {
      titre: get('titre'),
      description: get('description'),
      type: get('type'),
      dateSouhaitee: get('dateSouhaitee'),
      dureeEstimee: parseFloat(get('dureeEstimee')),
      tarifHoraire: parseFloat(get('tarifHoraire')),
      lieuAdresse: get('lieuAdresse'),
      lieuVille: get('lieuVille'),
      notesFamille: get('notesFamille'),
      statut: 'ouverte',
      famille: user.id,
    };

    try {
      const mission = await newMission(data);
      window.location.href = `/app/mission?id=${mission.id}`;
    } catch (err) {
      erreur.textContent = 'Erreur : ' + (err?.message || 'publication échouée.');
      erreur.classList.remove('hidden');
    }
  });
</script>
