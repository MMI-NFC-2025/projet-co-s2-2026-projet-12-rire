---
import Layout from '../../layouts/Layout.astro';
import Nav from '../../components/NavApp.astro';
import Footer from '../../components/Footer.astro';
---

<Layout title="Connexion — Rirē">
  <Nav />
  <main class="min-h-[70vh] flex items-center justify-center px-6 py-16 bg-rire-bg">
    <div class="w-full max-w-md bg-white rounded-2xl p-10 shadow-sm border border-gray-200">
      <h1 class="font-display text-3xl font-bold text-rire-ink mb-2">Connexion</h1>
      <p class="text-rire-muted mb-8">Connecte-toi à ton compte Rirē.</p>

      <form id="form-connexion" class="space-y-4">
        <div>
          <label for="email" class="block text-sm font-medium text-rire-ink mb-1">Email</label>
          <input type="email" id="email" required
            class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-rire-blue focus:ring-2 focus:ring-rire-blue/20" />
        </div>
        <div>
          <label for="password" class="block text-sm font-medium text-rire-ink mb-1">Mot de passe</label>
          <input type="password" id="password" required
            class="w-full px-4 py-3 border border-gray-200 rounded-lg focus:outline-none focus:border-rire-blue focus:ring-2 focus:ring-rire-blue/20" />
        </div>

        <div id="erreur" class="hidden text-red-600 text-sm p-3 bg-red-50 rounded-lg"></div>

        <button type="submit"
          class="w-full bg-rire-blue text-white py-3 rounded-lg font-semibold hover:opacity-90 transition">
          Se connecter
        </button>
      </form>

      <p class="text-center text-rire-muted text-sm mt-6">
        Pas encore de compte ?
        <a href="/app/inscription" class="text-rire-blue font-semibold">Inscris-toi</a>
      </p>
    </div>
  </main>
  <Footer />
</Layout>

<script>
  import { login, isAuthValid } from '../../lib/backend.mjs';

  if (isAuthValid()) {
    window.location.href = '/app/compte';
  }

  const form = document.getElementById('form-connexion');
  const erreur = document.getElementById('erreur') as HTMLElement | null;

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    if (erreur) erreur.classList.add('hidden');

    const email = (document.getElementById('email') as HTMLInputElement).value;
    const password = (document.getElementById('password') as HTMLInputElement).value;

    try {
      await login(email, password);
      window.location.href = '/app/compte';
    } catch (err) {
      if (erreur) {
        erreur.textContent = 'Email ou mot de passe incorrect.';
        erreur.classList.remove('hidden');
      }
    }
  });
</script>
